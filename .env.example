# ============================================================
# WhatsAppBusinessAI — Environment Configuration
# Copy this file to .env (project root) and fill in your values.
# Never commit the real .env file.
# ============================================================

# ── Django ───────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-in-production
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostgreSQL) ───────────────────────────────────
# Hybrid dev setup: native PostgreSQL 18 on the host.
POSTGRES_DB=whatsapp_business_ai
POSTGRES_USER=waba_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis (Docker container: `docker compose up -d redis`) ──
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TIMEZONE=Africa/Nairobi

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=change-me-jwt-signing-key

# ── CORS & CSRF ──────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ── Email (console backend in dev — prints to stdout) ───────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=WABA AI <noreply@wabaai.local>

# ── AI Providers (apps.ai — Phase 8) ─────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_AI_PROVIDER=openai

# ── WhatsApp Cloud API (apps.whatsapp) ────────────────────────
# Per-business credentials (phone_number_id, access_token, ...) are
# entered via the API per WhatsAppAccount, not here. These are the
# platform-level values (one Meta App, shared webhook for every business).
WHATSAPP_VERIFY_TOKEN=change-me-webhook-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com/v21.0
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# ── File Storage ─────────────────────────────────────────────
USE_S3=False
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
AWS_S3_REGION_NAME=us-east-1
MAX_UPLOAD_SIZE_MB=20

# ── Platform ─────────────────────────────────────────────────
PLATFORM_NAME=WABA AI
TIME_ZONE=Africa/Nairobi

# ── Super Admin seed (used by `python manage.py createsuperadmin`) ──
SUPERADMIN_EMAIL=admin@wabaai.local
SUPERADMIN_PASSWORD=change-me-strong-password
SUPERADMIN_FIRST_NAME=Platform

# ── Frontend (frontend/.env.local) ───────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
